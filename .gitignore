# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Environments & tooling caches
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# PlatformIO build output (toolchains and objects, hundreds of MB)
.pio/

# Editors
.idea/
.vscode/
*.swp

# OS
Thumbs.db
.DS_Store

# Local scratch (never commit generated plots etc.)
out/
*.png
!docs/**/*.png

# Claude Code local settings (machine-specific paths)
.claude/settings.local.json

# Detector weights (M8). ultralytics downloads these into the working directory
# on first use and caches them there; they are a few megabytes of binary that
# the tool re-fetches by itself, so they never belong in the history.
*.pt
