# Normalize to LF in the repository; Git converts on checkout for Windows users.
* text=auto eol=lf

# Binary assets: never apply end-of-line conversion (it would corrupt them).
*.stl binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary

# Generated: keep the lock file out of diffs and language statistics.
uv.lock linguist-generated=true

# The pinned vendor firmware is reference material, not our code.
vendor/** linguist-vendored=true
